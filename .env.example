# Copy to .env in the repository root and fill in values. Never commit .env.

# ── Model backends (agents/llm_client.py) ─────────────────────────────────────
# Ordered, comma-separated chains. A failing backend hands the request to the
# next one; if the whole chain fails Hermes uses local Llama 3 via Ollama.
# Backends: claude (Anthropic API), claude-cli (Claude Code login),
#           openai (OpenAI API), codex (Codex CLI login), auto.
# Reasoning = incident verdicts + detector tuning; code = firmware patches.
HERMES_BACKEND=claude,codex
HERMES_CODE_BACKEND=codex,claude
# Claude via the Anthropic API.
ANTHROPIC_API_KEY=
HERMES_CLAUDE_MODEL=claude-opus-5-5
# Claude via the Claude Code CLI (optional model alias such as opus or sonnet).
HERMES_CLAUDE_CLI_MODEL=
# OpenAI API models (used only by the openai backend).
OPENAI_API_KEY=
HERMES_MODEL=gpt-5.6-sol
HERMES_CODE_MODEL=gpt-5.6-sol
# Codex CLI model override (empty = Codex's configured default).
HERMES_CLI_MODEL=
# The CLI backends (claude-cli, codex) are refused when AES_PRODUCTION=1
# unless this is set to 1 after a risk review.
AES_ALLOW_AGENTIC_LLM=0

# Embedded Intel index and local Ollama embeddings.
AES_INTEL_DB=./data/aes_intel.sqlite3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
INTEL_MIN_RELEVANCE=0.65

# Authenticated MQTT/TLS monitor identity.
MQTT_HOST=192.168.4.1
MQTT_PORT=8883
MQTT_MONITOR_USERNAME=aes-monitor
MQTT_MONITOR_PASSWORD=
MQTT_CA_CERT=

# Human interfaces and notifications.
AES_DASHBOARD_TOKEN=
AES_DASHBOARD_HOSTS=localhost,127.0.0.1
AES_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DISCORD_WEBHOOK_URL=

# Authenticated state, approvals, and independent benchmark labels.
AES_AUDIT_HMAC_KEY=
AES_DEPLOY_APPROVAL_KEY=
AES_SKILL_APPROVAL_KEY=
AES_BENCHMARK_HMAC_KEY=
# Operator-signed benchmark corpora (scripts/label_sample.py output) used by
# the 80% / 10% detector-tuning gate. Defaults: aes_incidents.jsonl / aes_normals.jsonl.
AES_BENCHMARK_ATTACKS=./attack_labels.jsonl
AES_BENCHMARK_NORMALS=./normal_labels.jsonl

# Strict Gate 2 hardware test.
GATE2_REFERENCE_PORT=
GATE2_REFERENCE_DEVICE=
GATE2_ATTACK_HARNESS=
GATE2_ATTACK_REPLAY=./attack_labels.jsonl

# Physical firmware installation (all required in addition to approval).
AES_FLASH_ENFORCE=0
AES_FIRMWARE_PUBLIC_KEY=
AES_HARDWARE_SECURITY_VERIFIED=0

# Gateway quarantine.
AES_FIREWALL_ENFORCE=0
GATEWAY_SSH=pi@192.168.4.1

# Production switches. Development exceptions must be explicit.
AES_PRODUCTION=1
AES_ALLOW_UNREGISTERED_DEVICES=0
AES_INSECURE_DEV_MQTT=0
AES_ALLOW_VULN_SOURCE=0

NVD_API_KEY=
