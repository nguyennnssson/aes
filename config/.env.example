# ── Reasoning backend (OpenAI) ───────────────────────────────────────────────
# HERMES_BACKEND: "openai" uses the OpenAI SDK (needs OPENAI_API_KEY below);
# "codex" uses the local `codex` CLI (ChatGPT subscription auth, no key).
# Leave unset to auto-select: openai if OPENAI_API_KEY is present, else codex.
HERMES_BACKEND=openai
OPENAI_API_KEY=

# Reasoning model — incident verdicts, packet classification, self-tuning params.
# Point this at a newer model (e.g. gpt-6) when available; no code change needed.
HERMES_MODEL=gpt-5

# Code model — firmware patch generation (Codex, tuned for code-in-a-loop).
HERMES_CODE_MODEL=gpt-5-codex

# ── Supporting services ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./aes_chromadb
MQTT_HOST=localhost
MQTT_PORT=1883
DISCORD_WEBHOOK_URL=
NVD_API_KEY=
